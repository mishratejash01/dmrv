# ---------------------------------------------------------------------------
# Rainbow dMRV — environment variables
# Copy to .env.local and fill in real values from your Supabase project.
# NEVER commit .env.local. Only this .env.example (placeholders) is committed.
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser (used by the Supabase JS client)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only — full database access. Keep secret; used by admin/seed routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only — Supabase Management API (migrations / provisioning scripts)
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App base URL (used for auth redirects). Optional in local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
